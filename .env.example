PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=horus_market_dev
DB_USER=root
DB_PASS=

# Configurar solo al conectar una pasarela desde el backend.
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_ACCESS_TOKEN=

# Panel admin (/admin.html + /api/admin). Sin este secreto los tokens no son válidos.
# OBLIGATORIO en producción (mín. 32 caracteres): el servidor no arranca sin él.
ADMIN_SESSION_SECRET=cambia-esto-por-64-caracteres-aleatorios
# Solo para `npm run db:seed:admin` (crea/actualiza el usuario admin inicial).
ADMIN_EMAIL=admin@horus.local
ADMIN_PASSWORD=cambia-esta-clave-larga

# Confianza en X-Forwarded-For (req.ip, rate-limit, auditoría). 0 = directo sin
# proxy (desarrollo). Tras un proxy real (Render) usar 1. Nunca lo actives sin proxy.
TRUST_PROXY=0
# Límites por minuto e instancia (ver README "Despliegue multirréplica").
LOGIN_RATE_MAX=8
ADMIN_RATE_MAX=180

# Imágenes de productos. La carpeta puede copiarse independientemente del código.
# Ruta relativa al directorio de ejecución o absoluta fuera del repositorio.
PRODUCT_UPLOADS_DIR=uploads/productos
PRODUCT_IMAGE_MAX_MB=5
PRODUCT_IMAGE_STORAGE=local
# Opcional en producción; si queda vacío se usa protocolo + host de la petición.
PUBLIC_BASE_URL=
